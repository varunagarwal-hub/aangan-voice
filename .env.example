# ───────────────────────── Aangan voice intake — environment ─────────────────────────
# Copy to .env (local) and add the same values in Vercel → Project → Settings → Environment Variables.
# See docs/KEYS.md for where each value comes from.

# true = fake Vaani / Cal.com / Telegram / HubSpot / Gemini, and a local database if DATABASE_URL is empty.
MOCK_MODE=false
# Mock only: make services fail on purpose to test fallbacks, e.g. MOCK_FAIL=calcom,telegram
MOCK_FAIL=
# Public URL of this app (used in Telegram/HubSpot links). Locally: http://localhost:3000
APP_URL=https://your-app.vercel.app

# ── Security ──
# Random strings (e.g. `openssl rand -hex 24`). TOOL_SECRET goes into each Vaani custom tool.
TOOL_SECRET=
# Goes in the webhook URL you paste into Vaani: https://your-app.vercel.app/api/vaani/webhook?token=THIS
VAANI_WEBHOOK_TOKEN=
# Optional. Only if Vaani gives you a webhook signing secret (X-Vaani-Signature). Leave empty otherwise.
VAANI_WEBHOOK_SIGNING_SECRET=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" automatically.
CRON_SECRET=
# The one shared dashboard password for designers (mock mode default: "aangan").
DASHBOARD_PASSWORD=
# Signs the dashboard cookie. Changing it logs everyone out.
SESSION_SECRET=

# ── Neon Postgres ──
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Vaani (app.vaanivoice.ai → Settings → API Keys) ──
VAANI_API_KEY=vaani_xxx
VAANI_BASE_URL=https://api.vaanivoice.ai

# ── Cal.com (Settings → Developer → API Keys) ──
CALCOM_API_KEY=cal_live_xxx
# Numeric ID of the "Design consultation" event type
CALCOM_EVENT_TYPE_ID=
# How many days ahead to look for slots
SLOT_SEARCH_DAYS=14

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# Group chat id, negative number, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# ── HubSpot (Service Key or legacy private app token) ──
HUBSPOT_TOKEN=
HUBSPOT_API_VERSION=2026-09
HUBSPOT_PIPELINE=default
# Stage internal IDs — run `npm run hubspot:setup` to print yours.
HUBSPOT_STAGE_BOOKED=appointmentscheduled
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
HUBSPOT_STAGE_NOT_QUALIFIED=closedlost
HUBSPOT_STAGE_OTHER=appointmentscheduled

# ── Gemini (aistudio.google.com → Get API key) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (Gemini 3.x). Ignored for 2.5 models.
GEMINI_THINKING_LEVEL=low

# ── Cost per call (all INR unless stated). Leave blank if unknown: the dashboard flags missing rates. ──
# Vaani bills in credits (call-history "call_cost"). Set the INR value of one credit from your Vaani plan…
VAANI_INR_PER_CREDIT=
# …or, if you only know a per-minute price, set this instead.
VAANI_INR_PER_MIN=
# Set true if your Vaani price already includes the phone line / telephony.
VAANI_COST_INCLUDES_TELEPHONY=false
TELEPHONY_INR_PER_MIN=
# Gemini paid-tier price per 1M tokens in USD (ai.google.dev/gemini-api/docs/pricing). 3.8 Flash until 31 Dec 2026: 0.75 / 3.75
GEMINI_USD_PER_1M_INPUT=0.75
GEMINI_USD_PER_1M_OUTPUT=3.75
# Current USD→INR rate you want to use for Gemini cost
USD_TO_INR=
